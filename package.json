{
    "name": "chatluna-plugin-livingdiary",
    "version": "0.1.0",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "description": "LivingSystem 生态下构筑的 QQ 空间插件，提供动态发布、评论与回复能力。联动 livingmemory 插件实现 bot 的人格化日记记录与发布功能。",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "license": "AGPL-3.0-only",
    "keywords": [
        "chatluna-plugin"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json",
        "./client": "./client/index.ts"
    },
    "files": [
        "lib",
        "dist",
        "client",
        "src/journal/webui.ts",
        "README.md"
    ],
    "scripts": {
        "dev": "node scripts/build-client.mjs --watch",
        "build": "tsc -p tsconfig.json --listEmittedFiles && tsc -p tsconfig.client.json --noEmit && node scripts/build-client.mjs",
        "clean": "node scripts/clean.mjs",
        "pub": "npm run clean && npm run build && npm publish",
        "test": "npm run build && node --test \"tests/**/*.test.mjs\""
    },
    "dependencies": {
        "@chatluna/transform-image": "2.0.0-alpha.0",
        "qzone-sdk": "^0.3.3",
        "schemastery": "^3.18.0"
    },
    "peerDependencies": {
        "@chatluna/agent": "*",
        "@chatluna/ai": "*",
        "@chatluna/ai-runtime": "*",
        "@chatluna/core": "*",
        "@chatluna/preset": "*",
        "@chatluna/prompt": "*",
        "@chatluna/schema": "*",
        "@chatluna/ui-schema-registry": "*",
        "@chatluna/utils": "*",
        "@cordisjs/plugin-database": "^4.2.0",
        "@satorijs/core": "^4.6.1",
        "chatluna": "^2.0.0-alpha.0",
        "chatluna-plugin-livingmemory": ">=0.0.5",
        "cordis": "^4.0.0-rc.12"
    },
    "peerDependenciesMeta": {
        "chatluna-plugin-livingmemory": {
            "optional": true
        }
    },
    "devDependencies": {
        "@chatluna/engine-character": "*",
        "@chatluna/permission": "*",
        "@chatluna/runtime-webui": "*",
        "@chatluna/session": "*",
        "@chatluna/storage-files": "*",
        "@chatluna/tool": "*",
        "@chatluna/ui-client": "*",
        "@chatluna/ui-kit": "*",
        "@chatluna/ui-schema-form": "*",
        "@chatluna/ui-server": "*",
        "@cordisjs/plugin-database-sqlite": "^5.1.1",
        "@cordisjs/plugin-loader": "^1.0.0-rc.9",
        "@cordisjs/unyaml": "2.0.3",
        "@types/react": "^19.2.0",
        "cordis": "^4.0.0-rc.12",
        "koishi": "npm:@koishijs/core@4.18.11",
        "react": "^19.2.0",
        "typescript": "*",
        "vite": "^8.2.1"
    },
    "cordis": {
        "description": {
            "zh": "LivingSystem 生态下构筑的 QQ 空间插件，提供动态发布、评论与回复能力。联动 livingmemory 插件实现 bot 的人格化日记记录与发布功能。",
            "en": "A Qzone plugin in the LivingSystem ecosystem for publishing posts, commenting, and replying. With LivingMemory, your bot can write and share diary entries in its own voice."
        }
    }
}
