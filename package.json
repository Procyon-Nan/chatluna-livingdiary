{
    "name": "chatluna-plugin-livingdiary",
    "version": "0.0.0",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "description": "让机器人在 QQ 空间记录和分享日常。",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "license": "AGPL-3.0-only",
    "keywords": [
        "chatluna-plugin"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json --listEmittedFiles",
        "clean": "node scripts/clean.mjs",
        "pub": "npm run clean && npm run build && npm publish",
        "test": "npm run build && node --test \"tests/**/*.test.mjs\""
    },
    "dependencies": {
        "qzone-sdk": "^0.3.3",
        "schemastery": "^3.18.0"
    },
    "peerDependencies": {
        "@satorijs/core": "^4.6.1",
        "@chatluna/agent": "*",
        "@chatluna/ai": "*",
        "@chatluna/ai-runtime": "*",
        "@chatluna/core": "*",
        "@chatluna/preset": "*",
        "@chatluna/prompt": "*",
        "@chatluna/ui-schema-registry": "*",
        "@chatluna/utils": "*",
        "chatluna": "^2.0.0-alpha.0",
        "chatluna-plugin-livingmemory": ">=0.0.5",
        "cordis": "^4.0.0-rc.12"
    },
    "peerDependenciesMeta": {
        "chatluna-plugin-livingmemory": {
            "optional": true
        }
    },
    "devDependencies": {
        "@chatluna/engine-character": "*",
        "@chatluna/permission": "*",
        "@chatluna/session": "*",
        "@chatluna/storage-files": "*",
        "@chatluna/tool": "*",
        "@cordisjs/plugin-database": "^4.2.0",
        "cordis": "^4.0.0-rc.12",
        "koishi": "npm:@koishijs/core@4.18.11",
        "typescript": "*"
    },
    "cordis": {
        "description": {
            "zh": "让机器人在 QQ 空间记录和分享日常。",
            "en": "Let your bot share everyday moments on Qzone."
        }
    }
}
